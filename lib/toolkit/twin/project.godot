; The operable twin (lib/toolkit/twin): a Godot 4.7 project of its own, filled by toolkit/twin.py (the machine's glb into assets/,
; the materials into materials/, the import mapping), then run with twin.tscn. Core-owned; lib/godot/qa is the library's.
config_version=5

[application]

config/name="complexes-twin"
run/main_scene="res://twin.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

anti_aliasing/quality/msaa_3d=2
