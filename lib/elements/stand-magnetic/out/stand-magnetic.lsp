;; stand-magnetic v1.1. Generated. Millimetres. APPLOAD, then STANDMAG.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:STANDMAG (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-STEEL-7035" (list -25 -30 0) (list 25 30 0) 55)
  (CY "M-SILVER" (list 0 0 55) (list 0 0 255) 6)
  (CY "node-switch_M-BLACK-PA" (list -37 0 30) (list -25 0 30) 11)
  (BX "node-switch_M-BLACK-PA" (list -45 -3 30) (list -37 3 30) 22)
  (BX "node-arm_M-SILVER" (list -15 -15 255) (list 15 15 255) 25)
  (CY "node-arm_M-SILVER" (list 15 0 267.5) (list 165 0 267.5) 5)
  (setq e9 (BX "node-arm_M-SILVER" (list 165 -10 255.5) (list 185 10 255.5) 24))
  (setq hole (CY "node-arm_M-SILVER" (list 175 0 254.5) (list 175 0 280.5) 4)) (command "_.SUBTRACT" e9 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType STANDMAG.") (princ)
