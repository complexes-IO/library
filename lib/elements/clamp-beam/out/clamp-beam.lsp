;; clamp-beam v1.0. Generated. Millimetres. APPLOAD, then CLAMPBEAM.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:CLAMPBEAM (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "node-clamp_M-STEEL-7035" (list -500 -20 0) (list 500 400 0) 200))
  (setq hole (UB "node-clamp_M-STEEL-7035" (list -501 -21.2132 -21.2132) (list -500 -21.2132 -21.2132) (list -501 -20.5061 -20.5061) 1002 342.8427 250)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "node-clamp_M-STEEL-7035" (list -555 200 200) (list 555 400 200) 200)
  (BX "M-STEEL-7035" (list -600 -50 60) (list -560 400 60) 700)
  (BX "M-STEEL-7035" (list 560 -50 60) (list 600 400 60) 700)
  (BX "M-STEEL-7035" (list -600 200 760) (list 600 400 760) 60)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType CLAMPBEAM.") (princ)
