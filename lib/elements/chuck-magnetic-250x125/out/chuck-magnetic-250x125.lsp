;; chuck-magnetic-250x125 v1.0. Generated. Millimetres. APPLOAD, then CHUCKMAG.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:CHUCKMAG (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-SILVER" (list -125 -62.5 0) (list 125 62.5 0) 75))
  (setq hole (CY "M-SILVER" (list 126 0 40) (list 95 0 40) 6)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-SILVER" (list -125 -77.5 0) (list 125 -62.5 0) 15)
  (BX "M-SILVER" (list -125 62.5 0) (list 125 77.5 0) 15)
  (CY "node-lever_M-SILVER" (list 96 0 40) (list 126 0 40) 5)
  (CY "node-lever_M-SILVER" (list 126 0 40) (list 138 0 40) 14)
  (BX "node-lever_M-SILVER" (list 128 0 34) (list 136 80 34) 12)
  (CY "node-lever_M-BLACK-PA" (list 136 72 40) (list 156 72 40) 7)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType CHUCKMAG.") (princ)
