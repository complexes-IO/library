;; clamp-angle v2.0. Generated. Millimetres. APPLOAD, then CLAMPANG.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:CLAMPANG (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16 e17)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-CAST-BLUE" (list -20 -20 0) (list 100 100 0) 10)
  (BX "M-CAST-BLUE" (list -20 -20 10) (list 100 0 10) 40)
  (BX "M-CAST-BLUE" (list -20 0 10) (list 0 100 10) 40)
  (setq e3 (BX "M-CAST-BLUE" (list 42 70 10) (list 78 85 10) 40))
  (setq hole (CY "M-CAST-BLUE" (list 60 69 20) (list 60 86 20) 7)) (command "_.SUBTRACT" e3 "" hole "")
  (setq e5 (BX "M-CAST-BLUE" (list 70 42 10) (list 85 78 10) 40))
  (setq hole (CY "M-CAST-BLUE" (list 69 60 34) (list 86 60 34) 7)) (command "_.SUBTRACT" e5 "" hole "")
  (BX "node-pad-a_M-SILVER" (list 42 1 11) (list 78 11 11) 30)
  (CY "node-pad-a_M-SILVER" (list 60 11 20) (list 60 95 20) 6)
  (CY "node-pad-a_M-SILVER" (list 35 92 20) (list 85 92 20) 5)
  (BX "node-pad-b_M-SILVER" (list 1 42 11) (list 11 78 11) 30)
  (CY "node-pad-b_M-SILVER" (list 11 60 34) (list 95 60 34) 6)
  (CY "node-pad-b_M-SILVER" (list 92 35 34) (list 92 85 34) 5)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType CLAMPANG.") (princ)
