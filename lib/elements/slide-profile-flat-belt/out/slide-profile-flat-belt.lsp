;; slide-profile-flat-belt v1.1. Generated. Millimetres. APPLOAD, then SLIDEPROFFB.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:SLIDEPROFFB (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-GALV" (list 0 -50 0) (list 1000 50 0) 3))
  (setq e1 (BX "M-WHITE-PA" (list 0 -33 3) (list 1000 33 3) 12))
  (setq hole (UB "M-WHITE-PA" (list -1 -25 13) (list 0 -25 13) (list -1 -24 13) 1002 50 3)) (command "_.SUBTRACT" e1 "" hole "")
  (setq hole (CY "M-GALV" (list 50 -41 -1) (list 50 -41 4) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GALV" (list 50 41 -1) (list 50 41 4) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GALV" (list 500 -41 -1) (list 500 -41 4) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GALV" (list 500 41 -1) (list 500 41 4) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GALV" (list 950 -41 -1) (list 950 -41 4) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GALV" (list 950 41 -1) (list 950 41 4) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType SLIDEPROFFB.") (princ)
