;; hanger-vibration v1.1. Generated. Millimetres. APPLOAD, then VIBHANG.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:VIBHANG (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-GALV" (list -30 -20 -90) (list -27 20 -90) 90)
  (BX "M-GALV" (list 27 -20 -90) (list 30 20 -90) 90)
  (setq e2 (BX "M-GALV" (list -27 -20 -3) (list 27 20 -3) 3))
  (setq hole (CY "M-GALV" (list 0 0 -4) (list 0 0 1) 5.5)) (command "_.SUBTRACT" e2 "" hole "")
  (setq e4 (BX "M-GALV" (list -27 -20 -90) (list 27 20 -90) 3))
  (setq hole (CY "M-GALV" (list 0 0 -91) (list 0 0 -86) 11)) (command "_.SUBTRACT" e4 "" hole "")
  (setq e6 (CY "M-GASKET" (list 0 0 -87) (list 0 0 -57) 18))
  (setq hole (CY "M-GASKET" (list 0 0 -88) (list 0 0 -56) 6)) (command "_.SUBTRACT" e6 "" hole "")
  (setq e8 (CY "M-GALV" (list 0 0 -57) (list 0 0 -54) 16))
  (setq hole (CY "M-GALV" (list 0 0 -58) (list 0 0 -53) 5.5)) (command "_.SUBTRACT" e8 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType VIBHANG.") (princ)
