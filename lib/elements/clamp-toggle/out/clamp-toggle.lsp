;; clamp-toggle v1.0. Generated. Millimetres. APPLOAD, then TOGCLAMP.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:TOGCLAMP (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16 e17 e18 e19)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-ZINC" (list -32 -22 0) (list 32 22 0) 3))
  (setq hole (CY "M-ZINC" (list -24 -14 -1) (list -24 -14 4) 2.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-ZINC" (list -24 14 -1) (list -24 14 4) 2.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-ZINC" (list 24 -14 -1) (list 24 -14 4) 2.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-ZINC" (list 24 14 -1) (list 24 14 4) 2.75)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-ZINC" (list -12 -11.5 3) (list 12 -8.5 3) 35)
  (BX "M-ZINC" (list -12 8.5 3) (list 12 11.5 3) 35)
  (CY "M-ZINC" (list 0 -11.5 30) (list 0 11.5 30) 3)
  (CY "M-ZINC" (list 0 -11.5 30) (list 0 -13 30) 5)
  (CY "M-ZINC" (list 0 11.5 30) (list 0 13 30) 5)
  (setq e10 (CY "node-arm_M-ZINC" (list 0 -8 30) (list 0 8 30) 7))
  (setq hole (CY "M-ZINC" (list 0 -9 30) (list 0 9 30) 3.1)) (command "_.SUBTRACT" e10 "" hole "")
  (setq e12 (BX "node-arm_M-ZINC" (list 5 -8 26) (list 62 8 26) 8))
  (setq hole (CY "M-ZINC" (list 50 0 25) (list 50 0 35) 4.5)) (command "_.SUBTRACT" e12 "" hole "")
  (BX "node-arm_M-ZINC" (list -4 -5 35) (list 4 5 35) 65)
  (CY "node-arm_M-RED-PA" (list 0 0 62) (list 0 0 102) 7)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType TOGCLAMP.") (princ)
