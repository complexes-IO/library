;; valve-counterbalance v1.2. Generated. Millimetres. APPLOAD, then VALVE-COUNTERBALANCE.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:VALVE-COUNTERBALANCE (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-ZINC" (list 1 -20 -20) (list 81 20 -20) 40)
  (CY "M-SILVER" (list 41 0 19.5) (list 41 0 44) 15)
  (CY "M-ZINC" (list 41 0 43.5) (list 41 0 50) 10)
  (CY "node-screw_M-BLACK-PA" (list 41 0 50) (list 41 0 60) 5)
  (CY "node-port-1_M-STEEL-7035" (list 0 0 0) (list 1.5 0 0) 13)
  (CY "node-port-2_M-STEEL-7035" (list 80.5 0 0) (list 82 0 0) 13)
  (CY "node-port-12_M-STEEL-7035" (list 41 0 -19.5) (list 41 0 -21) 9)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType VALVE-COUNTERBALANCE.") (princ)
