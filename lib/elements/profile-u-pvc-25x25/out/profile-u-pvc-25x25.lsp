  (setq e0 (BX "M-GREY-PVC" (list 0 -12.5 0) (list 1000 12.5 0) 25))
  (setq hole (UB "M-GREY-PVC" (list -1 -10 2.5) (list 0 -10 2.5) (list -1 -9 2.5) 1002 20 23.5)) (command "_.SUBTRACT" e0 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType UPROFPVC.") (princ)
