  (CY "M-SILVER" (list -50 0 20) (list -50 0 170) 6)
  (setq e2 (BX "M-ZINC" (list -60 -10 170) (list -40 10 170) 20))
  (setq hole (CY "M-ZINC" (list -50 -11 180) (list -50 11 180) 4)) (command "_.SUBTRACT" e2 "" hole "")
  (CY "M-SILVER" (list -50 -100 180) (list -50 100 180) 4)
  (setq e6 (BX "node-arm-left_M-ZINC" (list -58 -98 172) (list -42 -84 172) 16))
  (setq hole (CY "node-arm-left_M-ZINC" (list -50 -99 180) (list -50 -83 180) 5)) (command "_.SUBTRACT" e6 "" hole "")
  (CY "node-arm-left_M-SILVER" (list -42 -91 180) (list 60 -91 180) 3)
  (BX "node-arm-left_M-BLACK-PA" (list 60 -96 172) (list 80 -86 172) 16)
  (setq e10 (BX "node-arm-right_M-ZINC" (list -58 84 172) (list -42 98 172) 16))
  (setq hole (CY "node-arm-right_M-ZINC" (list -50 83 180) (list -50 99 180) 5)) (command "_.SUBTRACT" e10 "" hole "")
  (CY "node-arm-right_M-SILVER" (list -42 91 180) (list 60 91 180) 3)
