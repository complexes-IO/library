;; runway-beam v1.0. Generated. Millimetres. APPLOAD, then RUNWAYBEAM.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:RUNWAYBEAM (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-YELLOW" (list -6000 -250 0) (list -5600 250 0) 30)
  (BX "M-YELLOW" (list 5600 -250 0) (list 6000 250 0) 30)
  (BX "M-YELLOW" (list -6000 -200 30) (list 6000 200 30) 30)
  (BX "M-YELLOW" (list -6000 -10 60) (list 6000 10 60) 640)
  (BX "M-YELLOW" (list -6000 -200 700) (list 6000 200 700) 30)
  (BX "M-YELLOW" (list -6000 -150 730) (list -5900 150 730) 150)
  (BX "M-YELLOW" (list 5900 -150 730) (list 6000 150 730) 150)
  (BX "node-rail_M-SILVER" (list -5890 -25 730) (list 5890 25 730) 50)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType RUNWAYBEAM.") (princ)
