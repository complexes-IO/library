;; clamp-sheet v1.0. Generated. Millimetres. APPLOAD, then CLAMP-SHEET.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:CLAMP-SHEET (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-CAST-BLUE" (list -70 -25 -30) (list -40 25 -30) 90)
  (BX "M-CAST-BLUE" (list -40.5 -25 -30) (list 0 25 -30) 30)
  (setq e2 (BX "M-CAST-BLUE" (list -40.5 -25 30) (list 0 25 30) 30))
  (setq hole (CY "M-CAST-BLUE" (list -20 0 29) (list -20 0 56) 6.5)) (command "_.SUBTRACT" e2 "" hole "")
  (CY "node-jaw_M-SILVER" (list -20 0 19.5) (list -20 0 55) 6)
  (BX "node-jaw_M-STEEL-7035" (list -33 -15 8) (list -7 15 8) 12)
  (setq e6 (CY "node-port-cap_M-GALV" (list -20 0 59.5) (list -20 0 72) 9))
  (setq hole (CY "M-GALV" (list -20 0 73) (list -20 0 63.2982) 5.1211)) (command "_.SUBTRACT" e6 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType CLAMP-SHEET.") (princ)
