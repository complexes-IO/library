;; door-oven v1.0. Generated. Millimetres. APPLOAD, then OVENDOOR.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:OVENDOOR (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-STEEL-7035" (list -1000 -50 0) (list -900 0 0) 2200)
  (BX "M-STEEL-7035" (list 900 -50 0) (list 1000 0 0) 2200)
  (BX "M-STEEL-7035" (list -900 -50 2100) (list 900 0 2100) 100)
  (BX "node-door-l_M-STEEL-7035" (list -1000 -150 10) (list -5 -50 10) 2190)
  (BX "node-door-l_M-ZINC" (list -85 -190 900) (list -65 -150 900) 20)
  (BX "node-door-l_M-ZINC" (list -85 -190 1280) (list -65 -150 1280) 20)
  (BX "node-door-l_M-ZINC" (list -85 -210 900) (list -65 -190 900) 400)
  (BX "node-door-r_M-STEEL-7035" (list 5 -150 10) (list 1000 -50 10) 2190)
  (BX "node-door-r_M-ZINC" (list 65 -190 900) (list 85 -150 900) 20)
  (BX "node-door-r_M-ZINC" (list 65 -190 1280) (list 85 -150 1280) 20)
  (BX "node-door-r_M-ZINC" (list 65 -210 900) (list 85 -190 900) 400)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType OVENDOOR.") (princ)
