;; clamp-bar-300 v1.1. Generated. Millimetres. APPLOAD, then CLAMPBAR.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:CLAMPBAR (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-CAST-BLUE" (list -20 -13 -110) (list 0 13 -110) 145)
  (BX "M-SILVER" (list 0 -5 0) (list 380 5 0) 25)
  (setq e2 (BX "node-jaw_M-CAST-BLUE" (list 41 -11 -110) (list 66 11 -110) 145))
  (setq hole (UB "node-jaw_M-CAST-BLUE" (list 40 -6 -1) (list 41 -6 -1) (list 40 -5 -1) 27 12 27)) (command "_.SUBTRACT" e2 "" hole "")
  (CY "node-jaw_M-SILVER" (list 1 0 -90) (list 11 0 -90) 12)
  (CY "node-jaw_M-SILVER" (list 11 0 -90) (list 41 0 -90) 6)
  (CY "node-jaw_M-BROWN" (list 66 0 -90) (list 146 0 -90) 12)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType CLAMPBAR.") (princ)
