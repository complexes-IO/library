  (setq hole (CY "M-STEEL-7035" (list -60 1 -60) (list -60 -5 -60) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list -60 1 60) (list -60 -5 60) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 60 1 -60) (list 60 -5 -60) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 60 1 60) (list 60 -5 60) 3.3)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-STEEL-7035" (list -20 -204 -20) (list 20 -4 -20) 40)
  (CY "M-STEEL-7035" (list -30 -204 0) (list 30 -204 0) 12)
  (setq e7 (BX "node-tilt_M-STEEL-7035" (list -60 -224 -60) (list 60 -220 -60) 120))
  (setq hole (CY "node-tilt_M-STEEL-7035" (list -50 -219 -50) (list -50 -225 -50) 2.25)) (command "_.SUBTRACT" e7 "" hole "")
  (setq hole (CY "node-tilt_M-STEEL-7035" (list -50 -219 50) (list -50 -225 50) 2.25)) (command "_.SUBTRACT" e7 "" hole "")
  (setq hole (CY "node-tilt_M-STEEL-7035" (list 50 -219 -50) (list 50 -225 -50) 2.25)) (command "_.SUBTRACT" e7 "" hole "")
  (setq hole (CY "node-tilt_M-STEEL-7035" (list 50 -219 50) (list 50 -225 50) 2.25)) (command "_.SUBTRACT" e7 "" hole "")
  (CY "node-tilt_M-STEEL-7035" (list -44.5 -204 0) (list -30.5 -204 0) 12)
