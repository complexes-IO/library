  (setq e0 (BX "M-STEEL-7035" (list -498 52 22) (list -478 448 22) 1976))
  (setq hole (UB "M-STEEL-7035" (list -496.5 53.5 23.5) (list -495.5 53.5 23.5) (list -496.5 54.5 23.5) 20 393 1973)) (command "_.SUBTRACT" e0 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType WSSH500.") (princ)
