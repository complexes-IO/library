;; corner-stacking-1000 v1.0. Generated. Millimetres. APPLOAD, then CRST1000.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:CRST1000 (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-STEEL-7035" (list -8 -8 0) (list 120 120 0) 8)
  (BX "M-STEEL-7035" (list -8 -8 -16) (list 0 120 -16) 16.5)
  (BX "M-STEEL-7035" (list -8 -8 -16) (list 120 0 -16) 16.5)
  (BX "M-STEEL-7035" (list 0 0 7.5) (list 60 8 7.5) 985)
  (BX "M-STEEL-7035" (list 0 0 7.5) (list 8 60 7.5) 985)
  (BX "M-STEEL-7035" (list -8 -8 992) (list 120 120 992) 8)
  (BX "M-STEEL-7035" (list -8 -8 999.5) (list 0 120 999.5) 16.5)
  (BX "M-STEEL-7035" (list -8 -8 999.5) (list 120 0 999.5) 16.5)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType CRST1000.") (princ)
