;; tag-plate v1.0. Generated. Millimetres. APPLOAD, then TAG.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:TAG (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-ALU-ANOD" (list 0 -1.5 0) (list 120 0 0) 60))
  (setq hole (CY "M-GASKET" (list 10 -2.5 10) (list 10 1 10) 1.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GASKET" (list 10 -2.5 50) (list 10 1 50) 1.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GASKET" (list 110 -2.5 10) (list 110 1 10) 1.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GASKET" (list 110 -2.5 50) (list 110 1 50) 1.75)) (command "_.SUBTRACT" e0 "" hole "")
  (CY "M-ZINC" (list 10 -1.5 10) (list 10 -2.3 10) 2.6)
  (CY "M-ZINC" (list 10 -1.5 50) (list 10 -2.3 50) 2.6)
  (CY "M-ZINC" (list 110 -1.5 10) (list 110 -2.3 10) 2.6)
  (CY "M-ZINC" (list 110 -1.5 50) (list 110 -2.3 50) 2.6)
  (BX "M-BLACK-PA" (list 8 -1.6 18) (list 112 -1.5 18) 26)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType TAG.") (princ)
