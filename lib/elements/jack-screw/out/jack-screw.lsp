;; jack-screw v1.1. Generated. Millimetres. APPLOAD, then JACKSCRW.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:JACKSCRW (/ os hole e0 e1 e2 e3 e4 e5 e6 e7)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (CY "M-CAST-BLUE" (list 0 0 0) (list 0 0 55) 25))
  (setq hole (CY "M-CAST-BLUE" (list 0 0 6) (list 0 0 56) 9)) (command "_.SUBTRACT" e0 "" hole "")
  (CY "node-screw_M-SILVER" (list 0 0 8) (list 0 0 57) 8)
  (setq e3 (CY "node-screw_M-SILVER" (list 0 0 56) (list 0 0 80) 15))
  (setq hole (UB "node-screw_M-SILVER" (list -16 -22 55) (list -15 -22 55) (list -16 -21 55) 32 10 26)) (command "_.SUBTRACT" e3 "" hole "")
  (setq hole (UB "node-screw_M-SILVER" (list -16 12 55) (list -15 12 55) (list -16 13 55) 32 10 26)) (command "_.SUBTRACT" e3 "" hole "")
  (CY "node-screw_M-SILVER" (list 0 0 80) (list 0 0 92) 5)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType JACKSCRW.") (princ)
