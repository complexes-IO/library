;; stand-micrometer v1.1. Generated. Millimetres. APPLOAD, then STANDMIC.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:STANDMIC (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-STEEL-7035" (list -60 -45 0) (list 60 45 0) 20)
  (CY "M-SILVER" (list 0 0 20) (list 0 0 150) 8)
  (BX "M-SILVER" (list -10 -20 150) (list 10 20 150) 10)
  (BX "M-SILVER" (list -10 -20 160) (list 10 -14 160) 30)
  (BX "M-SILVER" (list -10 14 160) (list 10 20 160) 30)
  (setq e8 (BX "node-head_M-STEEL-7035" (list -12 -13 168) (list 12 13 168) 60))
  (setq hole (UB "node-head_M-STEEL-7035" (list -13 -4 198) (list -12 -4 198) (list -13 -3 198) 26 8 31)) (command "_.SUBTRACT" e8 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType STANDMIC.") (princ)
