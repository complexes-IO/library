  (setq hole (CY "M-GASKET" (list -30 -41 -60) (list -30 -28 -60) 4)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GASKET" (list -10 -41 -60) (list -10 -28 -60) 4)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-GASKET" (list 10 -41 -60) (list 10 -28 -60) 4)) (command "_.SUBTRACT" e0 "" hole "")
