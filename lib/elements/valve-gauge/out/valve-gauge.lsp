  (setq hole (CY "M-GASKET" (list 0 0 41.2) (list 0 0 39) 6.8081)) (command "_.SUBTRACT" e3 "" hole "")
  (CY "M-BRASS" (list 0 -11 18) (list 0 -17 18) 7)
