  (CY "node-port-1_M-BRASS" (list 0 0 0) (list 0 0 -10.2052) 6.8081)
  (setq hole (CY "M-GASKET" (list 0 0 41) (list 0 0 27.7948) 6.8081)) (command "_.SUBTRACT" e0 "" hole "")
