;; thermostat-enc v1.1. Generated. Millimetres. APPLOAD, then TSTE.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:TSTE (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-GREY-PA" (list 0 -40 -30) (list 35 0 -30) 60))
  (BX "M-GREY-PA" (list 1 0 17.5) (list 34 7.5 17.5) 2)
  (BX "M-GREY-PA" (list 1 0 -19.5) (list 34 7.5 -19.5) 2)
  (BX "M-GREY-PA" (list 14.5 0 -27) (list 20.5 3 -27) 8)
  (BX "M-WHITE-PA" (list 4.5 -40.6 -7) (list 30.5 -40 -7) 26)
  (CY "node-dial_M-BLACK-PA" (list 17.5 -40.6 6) (list 17.5 -46.6 6) 10)
  (BX "node-dial_M-WHITE-PA" (list 16.5 -48.1 6) (list 18.5 -46.6 6) 7)
  (CY "M-ZINC" (list 11.5 -40 -24) (list 11.5 -41.2 -24) 2.2)
  (setq hole (UB "M-GASKET" (list 9.7 -38 -31) (list 10.7 -38 -31) (list 9.7 -37 -31) 3.6 9 1.5)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-GASKET" (list 9.7 -38 -30) (list 13.3 -29 -30) 0.5)
  (CY "M-ZINC" (list 23.5 -40 -24) (list 23.5 -41.2 -24) 2.2)
  (setq hole (UB "M-GASKET" (list 21.7 -38 -31) (list 22.7 -38 -31) (list 21.7 -37 -31) 3.6 9 1.5)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-GASKET" (list 21.7 -38 -30) (list 25.3 -29 -30) 0.5)
  (BX "M-WHITE-PA" (list 5 -40.2 19) (list 30 -40 19) 8)
  (BX "M-WHITE-PA" (list 5 -40.2 -20) (list 30 -40 -20) 4)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType TSTE.") (princ)
