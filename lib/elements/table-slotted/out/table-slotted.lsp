;; table-slotted v1.0. Generated. Millimetres. APPLOAD, then TABLETSLOT.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:TABLETSLOT (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-SILVER" (list -240 -580 0) (list -160 580 0) 30)
  (BX "M-SILVER" (list 160 -580 0) (list 240 580 0) 30)
  (setq e2 (BX "M-SILVER" (list -250 -600 30) (list 250 600 30) 70))
  (setq hole (UB "M-SILVER" (list -137 -601 72) (list -136 -601 72) (list -137 -600 72) 14 1202 29)) (command "_.SUBTRACT" e2 "" hole "")
  (setq hole (UB "M-SILVER" (list -142 -601 72) (list -141 -601 72) (list -142 -600 72) 24 1202 10)) (command "_.SUBTRACT" e2 "" hole "")
  (setq hole (UB "M-SILVER" (list -7 -601 72) (list -6 -601 72) (list -7 -600 72) 14 1202 29)) (command "_.SUBTRACT" e2 "" hole "")
  (setq hole (UB "M-SILVER" (list -12 -601 72) (list -11 -601 72) (list -12 -600 72) 24 1202 10)) (command "_.SUBTRACT" e2 "" hole "")
  (setq hole (UB "M-SILVER" (list 123 -601 72) (list 124 -601 72) (list 123 -600 72) 14 1202 29)) (command "_.SUBTRACT" e2 "" hole "")
  (setq hole (UB "M-SILVER" (list 118 -601 72) (list 119 -601 72) (list 118 -600 72) 24 1202 10)) (command "_.SUBTRACT" e2 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
