;; column v1.1. Generated. Millimetres. APPLOAD, then MCOLUMN.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:MCOLUMN (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-STEEL-7035" (list -300 -300 0) (list 300 300 0) 25))
  (setq hole (CY "M-STEEL-7035" (list -250 -250 -1) (list -250 -250 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list -250 0 -1) (list -250 0 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list -250 250 -1) (list -250 250 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 0 -250 -1) (list 0 -250 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 0 250 -1) (list 0 250 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 250 -250 -1) (list 250 -250 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 250 0 -1) (list 250 0 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-STEEL-7035" (list 250 250 -1) (list 250 250 26) 6.75)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-STEEL-7035" (list -200 -200 25) (list 200 200 25) 1575)
  (BX "node-ways_M-SILVER" (list -160 -225 400) (list -100 -200 400) 1160)
  (BX "node-ways_M-SILVER" (list 100 -225 400) (list 160 -200 400) 1160)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType MCOLUMN.") (princ)
