  (BX "M-ALU-ANOD" (list -3 -62.5 0) (list 0 62.5 0) 53)
  (BX "M-ALU-ANOD" (list -15 -62.5 50) (list -3 62.5 50) 3)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
