;; rack-bar v1.1. Generated. Millimetres. APPLOAD, then BARRACK.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:BARRACK (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16 e17 e18 e19 e20 e21 e22 e23 e24 e25 e26 e27 e28 e29 e30 e31 e32 e33 e34 e35 e36)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-STEEL-7035" (list -600 -300 0) (list 600 300 0) 110))
  (setq hole (UB "M-STEEL-7035" (list -590 -290 10) (list -589 -290 10) (list -590 -289 10) 1180 580 101)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-STEEL-7035" (list -590 -290 10) (list -540 -240 10) 1260)
  (BX "M-STEEL-7035" (list -590 240 10) (list -540 290 10) 1260)
