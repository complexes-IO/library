;; hold-down v1.1. Generated. Millimetres. APPLOAD, then HOLD-DOWN.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:HOLD-DOWN (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (BX "M-CAST-BLUE" (list -40 -40 0) (list 40 40 0) 15))
  (setq e1 (CY "M-CAST-BLUE" (list 0 0 -95) (list 0 0 0.5) 28))
  (setq hole (CY "M-CAST-BLUE" (list -30 -30 -1) (list -30 -30 16) 4.5)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-CAST-BLUE" (list -30 30 -1) (list -30 30 16) 4.5)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-CAST-BLUE" (list 30 -30 -1) (list 30 -30 16) 4.5)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-CAST-BLUE" (list 30 30 -1) (list 30 30 16) 4.5)) (command "_.SUBTRACT" e0 "" hole "")
  (setq hole (CY "M-CAST-BLUE" (list 0 0 -96) (list 0 0 -18) 16.5)) (command "_.SUBTRACT" e1 "" hole "")
  (CY "node-plunger_M-SILVER" (list 0 0 -20) (list 0 0 -110) 16)
  (CY "node-plunger_M-ORANGE-PA" (list 0 0 -110) (list 0 0 -122) 25)
  (CY "node-port-cap_M-STEEL-7035" (list 0 0 14.5) (list 0 0 16) 12)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType HOLD-DOWN.") (princ)
