;; beam-runway v1.1. Generated. Millimetres. APPLOAD, then BEAMRUNWAY.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:BEAMRUNWAY (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (BX "M-YELLOW" (list -3000 -10 20) (list 3000 10 20) 360)
  (BX "M-YELLOW" (list -3000 -100 380) (list 3000 100 380) 20)
  (BX "M-YELLOW" (list -2150 -150 400) (list -1850 150 400) 20)
  (BX "M-YELLOW" (list 1850 -150 400) (list 2150 150 400) 20)
  (BX "M-YELLOW" (list -3000 -80 20) (list -2940 -10 20) 80)
  (BX "M-YELLOW" (list -3000 10 20) (list -2940 80 20) 80)
  (BX "M-YELLOW" (list 2940 -80 20) (list 3000 -10 20) 80)
  (BX "M-YELLOW" (list 2940 10 20) (list 3000 80 20) 80)
  (BX "node-track_M-YELLOW" (list -3000 -100 0) (list 3000 100 0) 20)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType BEAMRUNWAY.") (princ)
