;; gun-spray v1.0. Generated. Millimetres. APPLOAD, then GUN-SPRAY.
(defun BX (lay p1 p2 h) (command "_.-LAYER" "_M" lay "") (command "_.BOX" p1 p2 h) (entlast))
(defun CY (lay p1 p2 r / h) (setq h (distance p1 p2)) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "_ZA" p1 p2) (command "_.CYLINDER" (list 0 0 0) r h) (command "_.UCS" "_W") (entlast))
(defun UB (lay o xp yp l w h) (command "_.-LAYER" "_M" lay "")
  (command "_.UCS" "3" o xp yp) (command "_.BOX" (list 0 0 0) (list l w 0) h) (command "_.UCS" "_W") (entlast))
(defun c:GUN-SPRAY (/ os hole e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11)
  (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0) (setvar "INSUNITS" 4) (setvar "ISOLINES" 8)
  (setq e0 (CY "node-port-1_M-ALU-ANOD" (list 0 0 0) (list 0 0 16) 11))
  (setq hole (CY "M-ALU-ANOD" (list 0 0 -1) (list 0 0 12.2052) 6.8081)) (command "_.SUBTRACT" e0 "" hole "")
  (BX "M-BLACK-PA" (list -14 -11 15.5) (list 14 11 15.5) 105)
  (BX "M-ALU-ANOD" (list -40 -14 120) (list 70 14 120) 40)
  (CY "M-SILVER" (list 69.5 0 140) (list 90 0 140) 15)
  (CY "M-SILVER" (list 89.5 0 140) (list 95 0 140) 3)
  (CY "M-BLACK-PA" (list -39.5 0 140) (list -58 0 140) 8)
  (CY "M-SILVER" (list 30 0 159.5) (list 30 0 175.5) 7)
  (CY "M-CASE-CLEAR" (list 30 0 175) (list 30 0 285) 45)
  (CY "M-BLACK-PA" (list 30 0 284.5) (list 30 0 293) 47)
  (BX "node-trigger_M-SILVER" (list 34 -9 42) (list 40 9 42) 78)
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType GUN-SPRAY.") (princ)
