  (setq e0 (CY "node-self_M-GASKET" (list 0 0 0) (list 0 0.3 0) 5.46))
  (setq hole (CY "M-GASKET" (list 0 -1 0) (list 0 1.3 0) 4.1)) (command "_.SUBTRACT" e0 "" hole "")
  (command "_.-LAYER" "_S" "0" "") (setvar "OSMODE" os) (command "_.ZOOM" "_E") (princ "\nBuilt.") (princ))
(princ "\nType M12SEAL.") (princ)
